        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading) {
    if (isLoading || newValue == '') {
        g_form.clearOptions('agenda');
        g_form.setReadOnly('agenda', true);
        return;
    }

    // Chama o Script Include via GlideAjax
    var ga = new GlideAjax('getFilteredAgendas');
    ga.addParam('sysparm_name', 'getFilteredAgendas');
    ga.addParam('sysparm_trainingID', newValue);

    ga.getXMLAnswer(function(response) {
        var agendas = JSON.parse(response);

        // Limpa as opções atuais
        g_form.clearOptions('agenda');

        // Adiciona as novas opções filtradas
        g_form.setReadOnly('agenda', false);
        agendas.forEach(function(agenda) {
            g_form.addOption('agenda', agenda.sys_id, agenda.label);
        });
    });
}]]></script>
