        <description/>
        <mobile_callable>false</mobile_callable>
        <name>getFilteredAgendas</name>
        <sandbox_callable>false</sandbox_callable>
        <script><![CDATA[var getFilteredAgendas = Class.create();
getFilteredAgendas.prototype = {
    initialize: function() {
    },

	getAgendas: function() {
        var trainingID = gs.getRequestParameter('sysparm_trainingID'); // Obtém o ID do Treinamento

		gs.info('Treinamento Recebido: ' + trainingID);
        if (!trainingID) {
            return JSON.stringify([]); // Retorna um array vazio se o parâmetro estiver ausente
        }

        var result = [];
        var gr = new GlideRecord('x_1593177_training_agenda');

        gr.addQuery('training', trainingID);
        gr.addQuery('remaining_vacancies', '>', 0);
        gr.orderBy('date');
        gr.query();

        while (gr.next()) {
            result.push({
                sys_id: gr.getValue('sys_id'),
                label: gr.getDisplayValue('date')
            });
        }
        return JSON.stringify(result);
    },

    type: 'getFilteredAgendas'
};]]></script>
