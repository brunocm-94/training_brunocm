        <access>public</access>
        <active>true</active>
        <api_name>x_1593177_training.TrainingSystemEnrollmentsReport</api_name>
        <caller_access/>
        <client_callable>false</client_callable>
        <description/>
        <mobile_callable>false</mobile_callable>
        <name>TrainingSystemEnrollmentsReport</name>
        <sandbox_callable>false</sandbox_callable>
        <script><![CDATA[var TrainingSystemEnrollmentsReport = Class.create();
TrainingSystemEnrollmentsReport.prototype = {
    initialize: function() {
    },

	getEnrollmentsForAgenda: function (agendaSysId) {
        var enrollments = [];
        var enrollmentGR = new GlideRecord('x_1593177_training_enrollment');
        enrollmentGR.addQuery('agenda', agendaSysId);
        enrollmentGR.query();

        while (enrollmentGR.next()) {
            var userName = enrollmentGR.enrolled_user.getDisplayValue();
            enrollments.push(userName);
        }

        return enrollments;
    },

    generateEmailBody: function (agendaGR) {
        var instructorEmail = agendaGR.instructor.email;
        var agendaTrainingName = agendaGR.training.name;
        var agendaDate = agendaGR.date.toString();
        var enrollments = this.getEnrollmentsForTraining(agendaGR.sys_id);

        var emailBody = "Hello " + agendaGR.instructor.name + ",\n\n";
        emailBody += "Here is the list of enrolled user for the training '" + agendaTrainingName + "' today, " + agendaDate + ":\n\n";

        if (enrollments.length > 0) {
            enrollments.forEach(function (user) {
                emailBody += "- " + user + "\n";
            });
        } else {
            emailBody += "No enrollments today.";
        }

        emailBody += "\n\nThanks,\nTraining System";
        return { body: emailBody, instructorEmail: instructorEmail };
    },

    type: 'TrainingSystemEnrollmentsReport'
};]]></script>
